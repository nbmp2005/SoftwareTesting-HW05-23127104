<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="23127104_Stress_20260830 CANDIDATE - CHUA DO" enabled="true">
  <stringProp name="TestPlan.comments">CANDIDATE - CHUA DO. Sinh tu SUT Context r1.1 + Data Matrix r1.1 + Profile Matrix Buoc 3 da duyet. Threshold that chi duoc cong bo sau khi co raw JTL + resource evidence.</stringProp>
  <boolProp name="TestPlan.functional_mode">false</boolProp>
  <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
  <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
  <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
    <collectionProp name="Arguments.arguments"/>
  </elementProp>
</TestPlan>
<hashTree>
